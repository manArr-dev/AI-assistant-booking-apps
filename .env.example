ANTHROPIC_API_KEY=your-key-here
# Any LangChain "provider:model" string works, e.g. openai:gpt-5.5 (then pip install langchain-openai and set OPENAI_API_KEY)
MODEL=anthropic:claude-sonnet-5-5
BUSINESS_NAME=Maple Street Studio

# ---- Travel APIs (travel_server.py). Everything defaults to "mock": offline, no keys, nothing really booked.
# Flights + hotels via Duffel (https://duffel.com). Use a duffel_test_ token: test mode never charges.
# Hotels (Duffel Stays) must be enabled on your Duffel account first.
FLIGHT_PROVIDER=mock        # mock | duffel
HOTEL_PROVIDER=mock         # mock | duffel
DUFFEL_ACCESS_TOKEN=duffel_test_your-token-here
# Car hire and rail need a partner contract; point these at your adapter (contract in travel/partner.py).
CAR_PROVIDER=mock           # mock | partner
CAR_API_URL=
CAR_API_KEY=
TRAIN_PROVIDER=mock         # mock | partner
TRAIN_API_URL=
TRAIN_API_KEY=

# ---- Authentication
# Every account must use an authenticator app (TOTP). Admins always do, even if this is false.
REQUIRE_MFA=true
SESSION_HOURS=8
# Shown as the account name in authenticator apps (defaults to BUSINESS_NAME).
MFA_ISSUER=Maple Street Studio
# Encrypts MFA secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is generated into .mfa.key next to the database (keep it out of git; it is
# in .gitignore). Losing or changing the key means everyone has to set up MFA again.
MFA_ENCRYPTION_KEY=
# Public URL of the HTTP servers, used in the OAuth protected-resource metadata.
# PUBLIC_BASE_URL=https://bookings.example.com

# ---- Web app (api_server.py)
# true when served over HTTPS (production); false for http://localhost development
COOKIE_SECURE=false

# ---- Database and cache
# Leave DATABASE_URL empty for a local SQLite file (BOOKING_DB, default bookings.db).
# PostgreSQL: postgresql://user:password@host:5432/booking   (add ?sslmode=require in the cloud)
DATABASE_URL=
DB_POOL_MAX=10
# Leave empty for an in-process cache. Redis caches supplier searches and shares the
# login rate limit across API replicas: redis://localhost:6379/0  (rediss:// for TLS)
REDIS_URL=
SEARCH_CACHE_TTL=300
# With PostgreSQL, MFA_ENCRYPTION_KEY above is REQUIRED (all servers must share it).
