# Non-secret settings -> ConfigMap "booking-config" (name gets a content hash, so any
# change rolls the pods). Secrets (DATABASE_URL, REDIS_URL, MFA_ENCRYPTION_KEY,
# DUFFEL_ACCESS_TOKEN) live in the "booking-secrets" Secret; see k8s/README.md.
LOG_LEVEL=INFO
COOKIE_SECURE=true
REQUIRE_MFA=true
SESSION_HOURS=8
SEARCH_CACHE_TTL=300
AUTH_RATE_LIMIT=30
DB_POOL_MAX=10
WEB_CONCURRENCY=2
# Requests only reach pods through the ingress controller, so trust its X-Forwarded-For.
FORWARDED_ALLOW_IPS=*
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
CAR_PROVIDER=mock
TRAIN_PROVIDER=mock
MFA_ISSUER=Travel Booking
